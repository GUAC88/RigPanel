# Maintainer: KJ5JDO <codyguilliaume@gmail.com>
pkgname=rigpanel
pkgver=1.0.0
pkgrel=1
pkgdesc="Browser control panel for the Yaesu FT-991A (CAT over USB)"
arch=('any')
url="https://github.com/GUAC88/RigPanel"
license=('GPL-3.0-or-later')
depends=('python' 'xdg-utils')
install=rigpanel.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "RigPanel-$pkgver"
    linux/install-files.sh "$pkgdir" /usr
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
