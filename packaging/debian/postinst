#!/bin/sh
set -e
if [ "$1" = configure ]; then
    command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications || true
    cat <<MSG

RigPanel is installed. Each user should:
  1. Join the serial-port group:   sudo usermod -aG dialout \$USER   (then log out and back in)
  2. Open "Rig Panel" from the app menu (or run: rigpanel). The first start asks for your callsign.
  Optional, start at login:        systemctl --user enable --now rigpanel

MSG
fi
