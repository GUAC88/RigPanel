#!/bin/sh
# RigPanel launcher: start the panel in the background if it isn't running, then open it in the browser.
#   rigpanel            start (if needed) and open http://localhost:<port>
#   rigpanel --server   run the panel in the foreground (used by the systemd user service)
#   rigpanel --stop     stop a running panel
#   rigpanel --setup    change callsign, radio port and other settings
SELF=$(readlink -f "$0")
BIN=$(dirname "$SELF")
APP=${RIGPANEL_HOME:-$(readlink -f "$BIN/../share/rigpanel")}
CFG="$HOME/.config/rigpanel/config.json"

port() {
    python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('http_port',8073))" "$CFG" 2>/dev/null || echo 8073
}
up() { python3 -c "import urllib.request,sys;urllib.request.urlopen(sys.argv[1],timeout=1)" "http://localhost:$1/api/config" 2>/dev/null; }

# Open a terminal for first-run setup when started from the app menu
in_terminal() {
    for t in x-terminal-emulator gnome-terminal konsole xfce4-terminal mate-terminal lxterminal kitty alacritty foot xterm; do
        command -v "$t" >/dev/null 2>&1 || continue
        case $t in
            gnome-terminal) exec "$t" --wait -- "$@" ;;
            *) exec "$t" -e "$@" ;;
        esac
    done
    return 1
}

case "$1" in
    --server) exec python3 "$APP/rigpanel.py" ;;
    --stop) pkill -f "python3 $APP/rigpanel.py" && echo "RigPanel stopped"; exit 0 ;;
    --setup) shift; exec "$BIN/rigpanel-setup" "$@" ;;
    --version) cat "$APP/VERSION" 2>/dev/null || echo unknown; exit 0 ;;
    -h|--help) sed -n '2,6p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [ ! -f "$CFG" ]; then
    if [ -t 0 ]; then "$BIN/rigpanel-setup" || exit 1
    else in_terminal sh -c "\"$BIN/rigpanel-setup\" && \"$SELF\"; echo; printf 'Press Enter to close '; read x"; fi
fi

P=$(port)
if ! up "$P"; then
    nohup python3 "$APP/rigpanel.py" >/dev/null 2>&1 &
    i=0
    while [ $i -lt 30 ] && ! up "$P"; do sleep 0.3; i=$((i + 1)); done
fi
xdg-open "http://localhost:$P" >/dev/null 2>&1 &
