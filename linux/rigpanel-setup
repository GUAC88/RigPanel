#!/bin/bash
# RigPanel station setup: writes ~/.config/rigpanel/config.json.
#   rigpanel-setup                      ask the questions
#   rigpanel-setup --yes --callsign N0CALL [--grid EM25fs] [--port /dev/ttyUSB0] [--baud 38400]
#                  [--winlink 145.030] [--http-port 8073]
set -e
CFG_DIR="$HOME/.config/rigpanel"
CFG="$CFG_DIR/config.json"
YES=0 CALL="" GRID="" PORT="" BAUD="" WL="" HTTP=""
while [ $# -gt 0 ]; do
    case "$1" in
        --yes|-y) YES=1 ;;
        --callsign) CALL=$2; shift ;;
        --grid) GRID=$2; shift ;;
        --port) PORT=$2; shift ;;
        --baud) BAUD=$2; shift ;;
        --winlink) WL=$2; shift ;;
        --http-port) HTTP=$2; shift ;;
        -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

c_ok=$'\e[32m' c_warn=$'\e[33m' c_head=$'\e[36m' c_off=$'\e[0m'
[ -t 1 ] || c_ok="" c_warn="" c_head="" c_off=""
info() { echo "  ${c_ok}[OK]${c_off} $*"; }
warn() { echo "  ${c_warn}[!]${c_off}  $*"; }
ask() {  # ask "question" default -> REPLY
    local q=$1 def=$2
    if [ "$YES" = 1 ]; then REPLY=$def; return; fi
    if [ -n "$def" ]; then read -rp "  $q [$def]: " REPLY; else read -rp "  $q: " REPLY; fi
    REPLY=${REPLY:-$def}
    REPLY=$(echo "$REPLY" | xargs)
}

# Existing values become the defaults
get() { python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],''))" "$CFG" "$1" 2>/dev/null || true; }
if [ -f "$CFG" ]; then
    : "${CALL:=$(get callsign)}" "${GRID:=$(get grid)}" "${PORT:=$(get serial_port)}" "${BAUD:=$(get baud)}" "${HTTP:=$(get http_port)}"
    if [ -z "$WL" ]; then w=$(get winlink_freq); [ -n "$w" ] && WL=$(python3 -c "print(f'{int(\"$w\")/1e6:.3f}')"); fi
fi

echo
echo "${c_head}Station setup${c_off}"
while :; do
    ask "Your callsign" "$CALL"; CALL=${REPLY^^}
    [[ $CALL =~ ^[A-Z0-9]{1,3}[0-9][A-Z0-9]{0,3}[A-Z]$ ]] && break
    warn "\"$CALL\" doesn't look like a callsign"
    [ "$YES" = 1 ] && exit 2
    CALL=""
done

# US calls: grid square from the FCC database via callook.info
if [ -z "$GRID" ]; then
    GRID=$(python3 - "$CALL" <<'EOF' 2>/dev/null || true
import json, sys, urllib.request
req = urllib.request.Request(f"https://callook.info/{sys.argv[1]}/json", headers={"User-Agent": "RigPanel-installer"})
d = json.load(urllib.request.urlopen(req, timeout=8))
if d.get("status") == "VALID":
    print(d["location"]["gridsquare"])
EOF
)
    [ -n "$GRID" ] && info "Found $CALL in the FCC database (grid $GRID)"
fi
while :; do
    ask "Grid square (Maidenhead, e.g. EM25fs)" "$GRID"; GRID=$REPLY
    [[ -z $GRID || $GRID =~ ^[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2})?$ ]] && break
    warn "Invalid grid square"; [ "$YES" = 1 ] && exit 2; GRID=""
done

# The FT-991A's CP2105 bridge shows up as two ports; CAT is the Enhanced one (interface 00)
FOUND=$(ls /dev/serial/by-id/ 2>/dev/null | grep CP210 | grep if00 | head -1 || true)
if [ -n "$FOUND" ]; then
    info "Radio CAT port looks like /dev/serial/by-id/$FOUND"
elif [ -z "$PORT" ]; then
    warn "No FT-991A found. Plug it in and turn it on; leave the port blank to auto-detect at startup."
fi
ask "Radio CAT port (blank = auto-detect at startup)" "$PORT"; PORT=$REPLY
while :; do
    ask "Radio CAT baud rate (radio MENU 031)" "${BAUD:-38400}"; BAUD=$REPLY
    [[ $BAUD =~ ^(4800|9600|19200|38400)$ ]] && break
    warn "Use 4800, 9600, 19200 or 38400"; [ "$YES" = 1 ] && exit 2; BAUD=""
done
while :; do
    ask "Your local Winlink VARA FM frequency in MHz" "${WL:-145.030}"; WL=$REPLY
    [[ $WL =~ ^[0-9]+(\.[0-9]+)?$ ]] && break
    warn "Enter a frequency like 145.030"; [ "$YES" = 1 ] && exit 2; WL=""
done
while :; do
    ask "Web port for the panel" "${HTTP:-8073}"; HTTP=$REPLY
    [[ $HTTP =~ ^[0-9]{4,5}$ ]] && break
    warn "Enter a port number like 8073"; [ "$YES" = 1 ] && exit 2; HTTP=""
done

mkdir -p "$CFG_DIR"
python3 - "$CFG" "$CALL" "$GRID" "$PORT" "$BAUD" "$HTTP" "$WL" <<'EOF'
import json, sys
p, call, grid, port, baud, http, wl = sys.argv[1:]
json.dump({"callsign": call, "grid": grid, "serial_port": port, "baud": int(baud),
           "http_port": int(http), "winlink_freq": round(float(wl) * 1e6)}, open(p, "w"), indent=2)
EOF
info "Saved settings to $CFG"

# Serial port access
GRP=$(getent group uucp >/dev/null && [ -e /etc/arch-release ] && echo uucp || echo dialout)
for d in /dev/ttyUSB0 /dev/ttyUSB1; do [ -e "$d" ] && GRP=$(stat -c %G "$d") && break; done
if ! id -nG | tr ' ' '\n' | grep -qx "$GRP"; then
    warn "You're not in the '$GRP' group, so the panel can't open the radio's serial port. Run:"
    warn "    sudo usermod -aG $GRP $USER     then log out and back in"
fi
if pgrep -f "rigpanel/rigpanel.py" >/dev/null; then
    warn "RigPanel is running with the old settings. Restart it: rigpanel --stop && rigpanel"
fi
